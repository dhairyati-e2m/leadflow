# ==============================================================================
# LeadFlow Environment Configuration (.env.example)
# IMPORTANT: Never commit .env or secrets to version control.
# Copy this file to .env for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16)
# Privileged role used strictly for initial migrations / schema setup
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadflow
# Non-superuser application role enforcing PostgreSQL Row-Level Security (RLS)
DATABASE_URL=postgresql+asyncpg://leadflow_app:leadflow_dev_password@localhost:5432/leadflow
# Non-superuser role used for testing RLS policies
DATABASE_TEST_URL=postgresql+asyncpg://leadflow_app:leadflow_dev_password@localhost:5432/leadflow_test

# Redis 7 (Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Provider Operational Modes: mock | live | disabled
# ==============================================================================

# Lead Sourcing / Enrichment Mode
PROVIDER_ENRICHMENT_MODE=mock

# Safe Crawler Settings
CRAWLER_MAX_CONCURRENT=5
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_PAGES_PER_DOMAIN=3
CRAWLER_MAX_RESPONSE_BYTES=2097152

# Optional Google PageSpeed Insights (Free tier: 25k req/day)
# Leave empty to keep provider disabled
GOOGLE_PAGESPEED_API_KEY=
PROVIDER_PAGESPEED_MODE=disabled

# Optional LLM Provider for Outreach Drafting (Free tier or Local Ollama)
# Options: none | ollama | openai-compatible
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3:8b

# Optional CRM Integration (HubSpot Free Developer App)
PROVIDER_HUBSPOT_MODE=disabled
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/v1/crm/hubspot/callback

# ==============================================================================
# Verified Free External Provider Integrations (Copy & Paste to .env)
# ==============================================================================

# 1. OpenRouter (Free AI Summaries & Outreach Personalization)
# Obtain key at: https://openrouter.ai/keys (No card required, set credit limit to $0.00)
# Models MUST end with ':free' (e.g. meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-thinking-exp:free)
PROVIDER_OPENROUTER_MODE=disabled
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_DAILY_LIMIT=150
OPENROUTER_RATE_LIMIT_PER_MINUTE=20

# 2. SerpApi (Search-Based Company Discovery & Public Evidence)
# Obtain key at: https://serpapi.com/manage-api-key (100 searches/month free recurring)
PROVIDER_SERPAPI_MODE=disabled
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=80

# 3. Hunter.io (Email Verification on Explicit Contact Reveal)
# Obtain key at: https://hunter.io/api_keys (25 searches + 50 verifications/month free)
PROVIDER_HUNTER_MODE=disabled
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=20

# 4. Resend (Transactional System Emails & Quota Alert Notifications)
# Obtain key at: https://resend.com/api-keys (100 emails/day, 3,000/month free recurring)
# IMPORTANT: Strictly reserved for system notifications; forbidden for prospect cold campaigns.
PROVIDER_RESEND_MODE=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_DAILY_LIMIT=80

# 5. DataForSEO (Disabled by Policy - No Recurring Free Tier)
# DataForSEO offers only a one-time $1 trial credit and requires pre-paid funds thereafter.
PROVIDER_DATAFORSEO_MODE=disabled
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
