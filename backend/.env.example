# ==============================================================================
# LeadFlow Environment Configuration (.env.example)
# IMPORTANT: Never commit .env or secrets to version control.
# Copy this file to .env for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16)
# Privileged role used strictly for initial migrations / schema setup
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadflow
# Non-superuser application role enforcing PostgreSQL Row-Level Security (RLS)
DATABASE_URL=postgresql+asyncpg://leadflow_app:leadflow_dev_password@localhost:5432/leadflow
# Non-superuser role used for testing RLS policies
DATABASE_TEST_URL=postgresql+asyncpg://leadflow_app:leadflow_dev_password@localhost:5432/leadflow_test

# Redis 7 (Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Provider Operational Modes: mock | live | disabled
# ==============================================================================

# Lead Sourcing / Enrichment Mode
PROVIDER_ENRICHMENT_MODE=mock

# Safe Crawler Settings
CRAWLER_MAX_CONCURRENT=5
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_PAGES_PER_DOMAIN=3
CRAWLER_MAX_RESPONSE_BYTES=2097152

# Optional Google PageSpeed Insights (Free tier: 25k req/day)
# Leave empty to keep provider disabled
GOOGLE_PAGESPEED_API_KEY=
PROVIDER_PAGESPEED_MODE=disabled

# Optional LLM Provider for Outreach Drafting (Free tier or Local Ollama)
# Options: none | ollama | openai-compatible
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3:8b

# Optional CRM Integration (HubSpot Free Developer App)
PROVIDER_HUBSPOT_MODE=disabled
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/v1/crm/hubspot/callback

# ==============================================================================
# Verified Free External Provider Integrations (Copy & Paste to .env)
# ==============================================================================

# Global External API Kill Switch (true = immediately block all outbound external provider calls)
GLOBAL_EXTERNAL_API_KILL_SWITCH=false

# Password Reset Token Expiry (Minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# 1. Brave Search API (Company Discovery & Public Evidence)
# Free Tier: 2,000 queries/month free recurring (1 req/sec)
# Obtain key at: https://api.search.brave.com/app/dashboard
# Modes: disabled | mock | live
PROVIDER_BRAVE_MODE=disabled
BRAVE_API_KEY=
BRAVE_MONTHLY_LIMIT=1600
BRAVE_DAILY_LIMIT=50
BRAVE_RATE_LIMIT_PER_SECOND=1

# 2. Google Gemini API (Context-Aware ICP Matching, Signal Classification, Lead Summaries)
# Free Tier: 15 RPM, 1,500 requests/day, 1M TPM free recurring (Google AI Studio)
# Obtain key at: https://aistudio.google.com/app/apikey (No credit card required)
# Allowed Models: gemini-1.5-flash (Genuinely free tier)
# Modes: disabled | mock | live
PROVIDER_GEMINI_MODE=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_DAILY_LIMIT=1000
GEMINI_RPM_LIMIT=10

# 3. SerpApi (Search-Based Company Discovery & Public Evidence)
# Free Tier: 100 searches/month free recurring
# Obtain key at: https://serpapi.com/manage-api-key
# Modes: disabled | mock | live
PROVIDER_SERPAPI_MODE=disabled
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=80

# 4. Hunter.io (Domain Email Search & Verification on Explicit Contact Reveal)
# Free Tier: 25 domain searches + 50 verifications/month free recurring
# Obtain key at: https://hunter.io/api_keys
# Modes: disabled | mock | live
PROVIDER_HUNTER_MODE=disabled
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=20
HUNTER_VERIFY_MONTHLY_LIMIT=40

# 5. Resend (Transactional System Emails & J5 Password Reset Verification)
# Free Tier: 100 emails/day, 3,000 emails/month free recurring
# Obtain key at: https://resend.com/api-keys
# IMPORTANT: Strictly reserved for system notifications/password recovery; forbidden for prospect cold campaigns.
# Modes: disabled | mock | live
PROVIDER_RESEND_MODE=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_DAILY_LIMIT=80

# 6. Firecrawl (Optional JavaScript-Rendered Scraping & Markdown Extraction)
# Free Tier: 1,000 credits/month free recurring (10 RPM limit)
# Obtain key at: https://firecrawl.dev/app/api-keys
# Modes: disabled | mock | live
PROVIDER_FIRECRAWL_MODE=disabled
FIRECRAWL_API_KEY=
FIRECRAWL_MONTHLY_LIMIT=800
FIRECRAWL_RPM_LIMIT=8

